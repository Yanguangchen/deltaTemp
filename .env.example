# Template — safe to commit. Contains no real values.
#
# Shared environment for everything under DeltaTemp. Copy it to your own private
# copy in THIS directory and fill that in:
#
#   copy .env.example .env.local      (Windows)
#   cp .env.example .env.local        (bash)
#
# Apps in subfolders read this file, so one copy covers all of them. An app can
# override any value with its own .env.local — load order, nearest first:
#
#   1. <app>\.env.local      <- private, gitignored
#   2. <app>\.env
#   3. DeltaTemp\.env.local  <- the usual place for your key
#   4. DeltaTemp\.env
#
# First file to define a key wins; a real shell variable beats all of them.
# Values are read once at boot. Restart the server after editing.
#
# On Vercel these files are not deployed. Set the same names with
# `vercel env add <NAME> production` instead (see gpr-annotator/README.md).
#
# .env, .env.local and friends are gitignored. This .example file is not —
# so never paste a real key below.

# ── gpr-annotator ─────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ids differ per account. In the app, Settings -> "List models my key can
# call" queries Google with your key and lists the ids that actually work.
#
#   gemini-3.8-flash          newest
#   gemini-3.7-flash          default below; popular, so often returns 503
#   gemini-3.6-flash
#   gemini-3.5-flash          reliable, ~6s per radargram
#   gemini-3.1-pro-preview    slower, better on faint reflectors
GEMINI_MODEL=gemini-3.7-flash

# Used automatically when the model above returns 429/503 "high demand".
# Leave empty to disable falling back and surface the error instead.
GEMINI_MODEL_FALLBACK=gemini-3.5-flash

# Attempts per model before moving on (backoff 1s, then 2s).
GEMINI_MAX_RETRIES=3

# ── Google sign-in (Firebase Auth) ────────────────────────
# Every /api/* call needs a signed-in Google user whom the Firestore rules
# approve (isAllowedUser() in DeltaTemp/firestore.rules). There is no list here:
# approving someone for the RAK apps approves them for GPR Annotator too.
#
# Firebase project whose ID tokens are accepted. Default: gprportal-49b88
FIREBASE_PROJECT_ID=

# ── Server ────────────────────────────────────────────────
# Serves Data Helper at / and GPR Annotator at /gpr-annotator/
PORT=8787
